# Roland JV-1080 patch editor for the EUCLID edition of the Polyend Tracker.
# Generated by euclid-synths/tools/jv1080_from_ini.py from RolandJV1080.ini in
# sonic-codex/jv1080-sysex-manager (MIT License, Copyright (c) 2025 Lt-Blmr), a
# transcription of Roland's JV-1080 MIDI implementation tables.
# Edits the Patch mode temporary patch (put the JV-1080 in Patch mode);
# the Patch group picks the patch.
# Device 1 is the JV-1080's device ID 17 (the usual), Device 2 is 18...
synth "Roland JV-1080"
hint "Patch mode: Patch group picks it (parts: JV-1080 Perform)"
pause 30
device 1
port din
template dt1 F0 41 d+10 6A 12 [ a3 a2 a1 a0 v ] F7
template dt1n F0 41 d+10 6A 12 [ a3 a2 a1 a0 n1 n0 ] F7
template dt1pt F0 41 d+10 6A 12 [ a3 a2 a1 a0 v v+1 n1+2 n0+2 ] F7
request F0 41 d+10 6A 11 [ 03 00 00 00 00 00 00 48 ] F7
request F0 41 d+10 6A 11 [ 03 00 10 00 00 00 01 01 ] F7
request F0 41 d+10 6A 11 [ 03 00 12 00 00 00 01 01 ] F7
request F0 41 d+10 6A 11 [ 03 00 14 00 00 00 01 01 ] F7
request F0 41 d+10 6A 11 [ 03 00 16 00 00 00 01 01 ] F7
parts 16 0 channel=1
request addr=0x01001000 stride=128 F0 41 d+10 6A 11 [ a3 a2 a1 a0 00 00 00 13 ] F7
dump dt1+dt1n+dt1pt F0 41 d+10 6A 12 [ a3 a2 a1 a0 data ] F7
name dt1 0x03000000 12
list jvgrouptype "User/Preset" "PCM card" "Expansion"
list jvgroupid "0" "1 User" "2 Card/Exp 2" "3 PrA/Exp 3" "4 PrB/Exp 4" "5 PrC/Exp 5" "6 PrD/Exp 6" "7 Exp 7" "8 Exp 8" "9 Exp 9" "10 Exp 10" "11 Exp 11" "12 Exp 12" "13 Exp 13" "14 Exp 14" "15 Exp 15" "16 Exp 16" "17 Exp 17" "18 Exp 18" "19 Exp 19" "20 Exp 20" "21 Exp 21" "22 Exp 22" "23 Exp 23" "24 Exp 24" "25 Exp 25" "26 Exp 26" "27 Exp 27" "28 Exp 28" "29 Exp 29" "30 Exp 30" "31 Exp 31" "32 Exp 32" "33 Exp 33" "34 Exp 34" "35 Exp 35" "36 Exp 36" "37 Exp 37" "38 Exp 38" "39 Exp 39" "40 Exp 40" "41 Exp 41" "42 Exp 42" "43 Exp 43" "44 Exp 44" "45 Exp 45" "46 Exp 46" "47 Exp 47" "48 Exp 48" "49 Exp 49" "50 Exp 50" "51 Exp 51" "52 Exp 52" "53 Exp 53" "54 Exp 54" "55 Exp 55" "56 Exp 56" "57 Exp 57" "58 Exp 58" "59 Exp 59" "60 Exp 60" "61 Exp 61" "62 Exp 62" "63 Exp 63" "64 Exp 64" "65 Exp 65" "66 Exp 66" "67 Exp 67" "68 Exp 68" "69 Exp 69" "70 Exp 70" "71 Exp 71" "72 Exp 72" "73 Exp 73" "74 Exp 74" "75 Exp 75" "76 Exp 76" "77 Exp 77" "78 Exp 78" "79 Exp 79" "80 Exp 80" "81 Exp 81" "82 Exp 82" "83 Exp 83" "84 Exp 84" "85 Exp 85" "86 Exp 86" "87 Exp 87" "88 Exp 88" "89 Exp 89" "90 Exp 90" "91 Exp 91" "92 Exp 92" "93 Exp 93" "94 Exp 94" "95 Exp 95" "96 Exp 96" "97 Exp 97" "98 Exp 98" "99 Exp 99" "100 Exp 100" "101 Exp 101" "102 Exp 102" "103 Exp 103" "104 Exp 104" "105 Exp 105" "106 Exp 106" "107 Exp 107" "108 Exp 108" "109 Exp 109" "110 Exp 110" "111 Exp 111" "112 Exp 112" "113 Exp 113" "114 Exp 114" "115 Exp 115" "116 Exp 116" "117 Exp 117" "118 Exp 118" "119 Exp 119" "120 Exp 120" "121 Exp 121" "122 Exp 122" "123 Exp 123" "124 Exp 124" "125 Exp 125" "126 Exp 126" "127 Exp 127"
group "Patch"
