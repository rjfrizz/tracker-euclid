param p 105 "7 source" 0 9 list=rtsrc
param p 113 "7 destination" 0 24 list=rtdst
param p 106 "8 source" 0 9 list=rtsrc
param p 114 "8 destination" 0 24 list=rtdst
group "Controls"
param p 115 "Footswitch 1" 0 10 list=footsw
param p 116 "Footswitch 2" 0 10 list=footsw
param p 117 "Footswitch 3" 0 10 list=footsw
param p 118 "Controller A" -128 127 init=0
param p 119 "Controller B" -128 127 init=0
param p 120 "Controller C" -128 127 init=0
param p 121 "Controller D" -128 127 init=0
param p 122 "Pressure" -128 127 init=0
param p 123 "Bend range" 0 13 init=2
param p 124 "Velocity curve" 0 5 list=velcurve
param p 125 "Key centre" 0 128 init=60
param p 126 "Output" 0 2 list=output
param p 127 "Tuning" 0 5 list=tuning
group "Links"
param p 12 "Link 1 preset" -1 511 init=-1
param p 13 "Link 2 preset" -1 511 init=-1
param p 14 "Link 3 preset" -1 511 init=-1
param p 15 "Low key 0" 0 127
param p 19 "High key 0" 0 127 init=127
