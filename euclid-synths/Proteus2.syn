# E-mu Proteus/2 preset editor for the EUCLID edition of the Polyend Tracker.
# Generated by euclid-synths/tools/edisyn_proteus2.py from Edisyn's EmuProteus.java
# (https://github.com/eclab/edisyn, Apache License 2.0, Copyright Sean Luke).
# Edits the current preset with parameter changes. A Proteus can't send its
# current preset, so there's no getting it (Shift + Insert).
# Device 1 is the Proteus's MIDI ID 0 (its usual), Device 2 is ID 1...
synth "E-mu Proteus/2"
hint "Pick presets on the Proteus (it can't send them)"
pause 20
device 1
port din
template p F0 18 04 d+00 03 pl ph vl vh F7
list offon "Off" "On"
list inst "No Instrument" "Arco Basses" "Arco Celli" "Arco Violas" "Arco Violin" "Dark Basses" "Dark Celli" "Dark Violas" "Dark Violin" "Low Tremolo" "High Tremolo" "Tremolande" "Strings 1" "Strings 2" "Strings 3" "Solo Cello" "Solo Viola" "Solo Violin" "Quartet 1" "Quartet 2" "Quartet 3" "Quartet 4" "Gambambo" "Pizz Basses" "Pizz Celli" "Pizz Violas" "Pizz Violin" "Pizzicombo" "Flute w/Vib" "Flute noVib" "Flute" "Piccolo" "Bass Clarinet" "Clarinet" "Bass Clarinet/Clarinet" "Contra Bassoon" "Bassoon" "English Horn" "Oboe w/Vib" "Oboe noVib" "Oboe" "Woodwinds" "Hi Trombone" "Lo Trombone" "MF Trumpet" "FF Trumpet" "Harmon Mute" "MF French Horn" "FF French Horn" "Tuba" "FF Brass" "MF Brass" "Harp" "Xylophone" "Celesta" "Triangle" "Bass Drum" "Snare Drum" "Piatti" "Temple Block" "Glockenspiel" "Percussion 1" "Percussion 2" "Low Percussion 2" "High Percussion 2" "Tubular Bell" "Timpani" "Timpani/Tubular Bell" "Tambourine" "Tam Tam" "Percussion 3" "Special Effects" "Oct 1 (Sine)" "Oct 2 All" "Oct 3 All" "Oct 4 All" "Oct 5 All" "Oct 6 All" "Oct 7 All" "Oct 2 Odd" "Oct 3 Odd" "Oct 4 Odd" "Oct 5 Odd" "Oct 6 Odd" "Oct 7 Odd" "Oct 2 Even" "Oct 3 Even" "Oct 4 Even" "Oct 5 Even" "Oct 6 Even" "Oct 7 Even" "Low Odds" "Low Evens" "Four Octaves" "Sine Wave" "Triangle Wave" "Square Wave" "Pulse 33%" "Pulse 25%" "Pulse 10%" "Sawtooth" "Sawtooth Odd Gone" "Ramp" "Ramp Even Only" "Violin Essence" "Buzzoon" "Brassy Wave" "Reedy Buzz" "Growl Wave" "HarpsiWave" "Fuzzy Gruzz" "Power 5ths" "Filtered Saw" "Ice Bell" "Bronze Age" "Iron Plate" "Aluminum" "Lead Beam" "Steel Extract" "Winter Glass" "Town Bell Wash" "Orchestral Bells" "Tubular SE" "Soft Bell Wave" "Swirly" "Tack Attack" "Shimmer Wave" "Moog Lead" "B3 SE" "Mild Tone" "Piper" "Ah Wave" "Vocal Wave" "Fuzzy Clav" "Electrhode" "Whine 1" "Whine 2" "Metal Drone" "Silver Race" "Metal Attack" "Filter Bass" "Upright Pizz" "Nylon Pluck 1" "Nylon Pluck 2" "Plucked Bass"
map inst 0x0000 0x0101 0x0102 0x0103 0x0104 0x0105 0x0106 0x0107 0x0108 0x0109 0x010A 0x010D 0x010B 0x010C 0x010E 0x0201 0x0202 0x0203 0x0205 0x0206 0x0207 0x0208 0x0204 0x0209 0x020A 0x020B 0x020C 0x020D 0x010F 0x013F 0x0141 0x0110 0x020E 0x020F 0x0210 0x0211 0x0212 0x0213 0x0214 0x021E 0x024F 0x0215 0x0111 0x0140 0x0112 0x0113 0x0216 0x0114 0x0115 0x0116 0x0117 0x0118 0x0119 0x011A 0x011B 0x011C 0x011D 0x011E 0x011F 0x0120 0x0121 0x0122 0x0123 0x0124 0x0125 0x0217 0x0218 0x0219 0x021A 0x021B 0x021C 0x021D 0x0126 0x0127 0x0128 0x0129 0x012A 0x012B 0x012C 0x012D 0x012E 0x012F 0x0130 0x0131 0x0132 0x0133 0x0134 0x0135 0x0136 0x0137 0x0138 0x0139 0x013A 0x013B 0x0220 0x0221 0x0222 0x0223 0x0224 0x0225 0x0226 0x0227 0x0228 0x0229 0x022A 0x022B 0x022C 0x022D 0x022E 0x022F 0x0230 0x0231 0x0232 0x0233 0x0234 0x0235 0x0236 0x0237 0x0238 0x0239 0x023A 0x023B 0x023C 0x023D 0x023E 0x023F 0x0240 0x0241 0x0242 0x0243 0x0244 0x0245 0x0246 0x0247 0x0248 0x0249 0x024A 0x024B 0x024C 0x024D 0x024E 0x021F 0x013C 0x013D 0x013E
list lfo "Random" "Triangle" "Sine" "Sawtooth" "Square"
list xfade "Off" "Crossfade" "Cross-switch"
list xdir "Pri->Sec" "Sec->Pri"
list velcurve "Off" "1" "2" "3" "4" "Global"
list tuning "Equal" "Just C" "Valotti" "19 Tone" "Gamelan" "User"
list output "Main" "Sub 1" "Sub 2"
list footsw "Off" "Sustain" "Primary Sustain" "Secondary Sustain" "Alternate Volume Env" "Primary Alternate Volume Env" "Secondary Alternate Volume Env" "Alternate Volume Rel" "Primary Alternate Volume Rel" "Secondary Alternate Volume Rel" "Cross-Switch"
list rtsrc "Pitch Wheel" "MIDI Control A" "MIDI Control B" "MIDI Control C" "MIDI Control D" "Mono Pressure" "Polyphonic Pressure" "LFO 1" "LFO 2" "Auxilliary Envelope"
list rtdst "Off" "Pitch" "Primary Pitch" "Secondary Pitch" "Volume" "Primary Volume" "Secondary Volume" "Attack" "Primary Attack" "Secondary Attack" "Decay" "Primary Decay" "Secondary Decay" "Release" "Primary Release" "Secondary Release" "Crossfade" "LFO 1 Amount" "LFO 1 Rate" "LFO 2 Amount" "LFO 2 Rate" "Auxiliary Envelope Amount" "Auxiliary Envelope Attack" "Auxiliary Envelope Decay" "Auxiliary Envelope Release"
list kvsrc "Key" "Velocity"
list kvdst "Off" "Pitch" "Primary Pitch" "Secondary Pitch" "Volume" "Primary Volume" "Secondary Volume" "Attack" "Primary Attack" "Secondary Attack" "Decay" "Primary Decay" "Secondary Decay" "Release" "Primary Release" "Secondary Release" "Crossfade" "LFO 1 Amount" "LFO 1 Rate" "LFO 2 Amount" "LFO 2 Rate" "Auxiliary Envelope Amount" "Auxiliary Envelope Attack" "Auxiliary Envelope Decay" "Auxiliary Envelope Release" "Sample Start" "Primary Sample Start" "Secondary Sample Start" "Pan" "Primary Pan" "Secondary Pan" "Tone" "Primary Tone" "Secondary Tone"
group "Primary"
param p 23 "Instrument" 0 144 list=inst map=inst init=1
param p 27 "Volume" 0 127 init=127
param p 28 "Pan" -7 7 init=0
param p 25 "Tune" -36 36 init=0
param p 26 "Fine tune" -64 64 init=0
param p 24 "Sound start" 0 127
param p 29 "Delay" 0 127
param p 30 "Low key" 0 127
param p 31 "High key" 0 127 init=127
param p 32 "Attack" 0 99
param p 33 "Hold" 0 99
param p 34 "Decay" 0 99
param p 35 "Sustain" 0 99 init=99
param p 36 "Release" 0 99
param p 37 "Own envelope" 0 1 list=offon
param p 38 "Solo" 0 1 list=offon
param p 39 "Chorus" 0 15
param p 40 "Reverse" 0 1 list=offon
group "Secondary"
param p 41 "Instrument" 0 144 list=inst map=inst init=0
param p 45 "Volume" 0 127 init=127
param p 46 "Pan" -7 7 init=0
param p 43 "Tune" -36 36 init=0
param p 44 "Fine tune" -64 64 init=0
param p 42 "Sound start" 0 127
param p 47 "Delay" 0 127
param p 48 "Low key" 0 127
param p 49 "High key" 0 127 init=127
param p 50 "Attack" 0 99
param p 51 "Hold" 0 99
param p 52 "Decay" 0 99
param p 53 "Sustain" 0 99 init=99
param p 54 "Release" 0 99
param p 55 "Own envelope" 0 1 list=offon
param p 56 "Solo" 0 1 list=offon
param p 57 "Chorus" 0 15
param p 58 "Reverse" 0 1 list=offon
group "Crossfade"
param p 59 "Mode" 0 2 list=xfade
param p 60 "Direction" 0 1 list=xdir
param p 61 "Balance" 0 127
param p 62 "Amount" 0 255
param p 63 "Switch point" 0 128 init=60
group "LFOs"
param p 64 "LFO 1 shape" 0 4 list=lfo
param p 65 "LFO 1 rate" 0 127
param p 66 "LFO 1 delay" 0 127
param p 67 "LFO 1 variation" 0 127
param p 68 "LFO 1 amount" -128 127 init=0
param p 69 "LFO 2 shape" 0 4 list=lfo
param p 70 "LFO 2 rate" 0 127
param p 71 "LFO 2 delay" 0 127
param p 72 "LFO 2 variation" 0 127
param p 73 "LFO 2 amount" -128 127 init=0
group "Aux envelope"
param p 80 "Amount" -128 127 init=0
param p 74 "Delay" 0 127
param p 75 "Attack" 0 99
param p 76 "Hold" 0 99
param p 77 "Decay" 0 99
param p 78 "Sustain" 0 99
param p 79 "Release" 0 99
group "Key/velocity"
param p 81 "1 source" 0 1 list=kvsrc
param p 87 "1 destination" 0 33 list=kvdst
param p 93 "1 amount" -128 127 init=0
param p 82 "2 source" 0 1 list=kvsrc
param p 88 "2 destination" 0 33 list=kvdst
param p 94 "2 amount" -128 127 init=0
param p 83 "3 source" 0 1 list=kvsrc
param p 89 "3 destination" 0 33 list=kvdst
param p 95 "3 amount" -128 127 init=0
param p 84 "4 source" 0 1 list=kvsrc
param p 90 "4 destination" 0 33 list=kvdst
param p 96 "4 amount" -128 127 init=0
param p 85 "5 source" 0 1 list=kvsrc
param p 91 "5 destination" 0 33 list=kvdst
param p 97 "5 amount" -128 127 init=0
param p 86 "6 source" 0 1 list=kvsrc
param p 92 "6 destination" 0 33 list=kvdst
param p 98 "6 amount" -128 127 init=0
group "Realtime"
param p 99 "1 source" 0 9 list=rtsrc
param p 107 "1 destination" 0 24 list=rtdst
param p 100 "2 source" 0 9 list=rtsrc
param p 108 "2 destination" 0 24 list=rtdst
param p 101 "3 source" 0 9 list=rtsrc
param p 109 "3 destination" 0 24 list=rtdst
param p 102 "4 source" 0 9 list=rtsrc
param p 110 "4 destination" 0 24 list=rtdst
param p 103 "5 source" 0 9 list=rtsrc
param p 111 "5 destination" 0 24 list=rtdst
param p 104 "6 source" 0 9 list=rtsrc
