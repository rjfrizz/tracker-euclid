# Yamaha SEQTRAK DX tracks for the EUCLID edition of the Polyend Tracker.
# Generated by euclid-synths/tools/seqtrak_from_datalist.py from Yamaha's
# SEQTRAK Data List (Sound List, MIDI Data Format and MIDI Data Table).
# A SEQTRAK track listens on its own MIDI channel (Kick 1 ... Perc 2 7,
# Synth 1 8, Synth 2 9, DX 10): Device follows the channel's MIDI channel,
# so set that to the track's.
# Sound sends bank MSB 63, LSB (sound - 1) / 128 and the program; the rest
# are the track's control changes. Settings aren't read back (the SEQTRAK
# has no patch dump), so the page shows what was last sent.
synth "Yamaha SEQTRAK DX"
hint "MIDI channel = the track: DX 10"
pause 2
device follow
port din
template cc d+B0 p v
template sound d+B0 00 3F | d+B0 20 vh | d+C0 vl
list sounds "FM Lo-Fi Bass" "FM Up Bass" "FM Ducking Bass" "FM Amp Sub" "FM Decay Bass" "Wobble Bass" "FM Dark Bass" "Beep Bass" "Feel It" "Attack Bass" "FM Jet Bass" "FM Bold Bass" "FM Metal Dissonant" "FM Metallic Lead" "FM Square and 5th Saw" "Dyna Lead" "Mo Dem Lead" "Bit Tune" "Bleep Clv" "Uni Lead" "FM Chorus 5th Lead" "FM Square Module" "FM Lil Dist Airy" "FM Ring Lead" "FM Pan Trem Lead" "FM Saw Bright" "FM Crush Computer" "FM Simple Piano" "FM B Piano" "FM B Piano [Chord]" "FM Clavi Piano" "Legend EP" "Legend EP [Chord]" "Wood EP" "Wood EP [Chord]" "Wood EP Tremolo" "Crystal EP" "FM Chorus Jazz EP" "FM Clear EP" "DigiChord" "Cheez Organ" "FM Rotate Organ" "FM Pipe A" "FM 5th Atmosphere" "FM Glass Dream" "FM Glass Dream [Chord]" "Motion Pad" "Begin Sweep" "Cloud Pad" "Sol Phase" "Flying Kode" "AlTi Pad" "Star Pad" "FM Warm Pad" "FM Warm Pad [Chord]" "FM Glass Harp" "FM Slow Phaser Pad" "FM Ambient Pad" "FM Strings Pad" "FM Strings" "FM Cold Strings" "FM Soft Brass" "FM Digital Brass" "FM Brass" "FM Hit Brass" "FM Hit Brass [Chord]" "FM Fun Brass" "FM Chorus Flute" "FM Sax" "FM Chorus Guitar" "FM Chorus Guitar [Chord]" "FM Wah Guitar" "FM Dist Guitar" "Ambi Pluck" "FM Koto" "FM Shamisen" "FM Sitar" "FM Echo Mallet" "Tin Perc" "FM Marimba" "FM Tubular Bells" "FM Tubular Bells [Chord]" "Future Bell" "FM Decay Bass [Arp]" "FM Dark Bass [Arp]" "Mo Dem Lead [Arp]" "Bit Tune [Arp]" "Uni Lead [Arp]" "FM Simple Piano [Arp]" "Legend EP [Arp]" "Wood EP [Arp]" "Star Pad [Arp]" "FM Brass [Arp]" "Ambi Pluck [Arp]" "FM Echo Mallet [Arp]" "Tin Perc [Arp]" "FM Marimba [Arp]" "D'n Beats" "Buzz Siren" "Chopper"
list onoff "Off" "On"
list eq "-12.0 dB" "-11.5 dB" "-11.0 dB" "-10.5 dB" "-10.0 dB" "-9.5 dB" "-9.0 dB" "-8.5 dB" "-8.0 dB" "-7.5 dB" "-7.0 dB" "-6.5 dB" "-6.0 dB" "-5.5 dB" "-5.0 dB" "-4.5 dB" "-4.0 dB" "-3.5 dB" "-3.0 dB" "-2.5 dB" "-2.0 dB" "-1.5 dB" "-1.0 dB" "-0.5 dB" "+0.0 dB" "+0.5 dB" "+1.0 dB" "+1.5 dB" "+2.0 dB" "+2.5 dB" "+3.0 dB" "+3.5 dB" "+4.0 dB" "+4.5 dB" "+5.0 dB" "+5.5 dB" "+6.0 dB" "+6.5 dB" "+7.0 dB" "+7.5 dB" "+8.0 dB" "+8.5 dB" "+9.0 dB" "+9.5 dB" "+10.0 dB" "+10.5 dB" "+11.0 dB" "+11.5 dB" "+12.0 dB"
list mono "Mono" "Poly" "Chord"
list arps "Off" "Up" "Up 2Octave" "Down" "Down 2Octave" "Random" "Random 2Octave" "Up / Down A" "Up / Down A 2Octave" "Up / Down B" "Up / Down B 2Octave" "Thumb Up" "Unison" "Chord 1" "Chord 2" "As Played"
list arpgate "0%" "2%" "3%" "5%" "6%" "8%" "9%" "11%" "13%" "14%" "16%" "17%" "19%" "20%" "22%" "24%" "25%" "27%" "28%" "30%" "31%" "33%" "35%" "36%" "38%" "39%" "41%" "43%" "44%" "46%" "47%" "49%" "50%" "52%" "54%" "55%" "57%" "58%" "60%" "61%" "63%" "65%" "66%" "68%" "69%" "71%" "72%" "74%" "76%" "77%" "79%" "80%" "82%" "83%" "85%" "87%" "88%" "90%" "91%" "93%" "94%" "96%" "98%" "99%" "101%" "102%" "104%" "106%" "107%" "109%" "110%" "112%" "113%" "115%" "117%" "118%" "120%" "121%" "123%" "124%" "126%" "128%" "129%" "131%" "132%" "134%" "135%" "137%" "139%" "140%" "142%" "143%" "145%" "146%" "148%" "150%" "151%" "153%" "154%" "156%" "157%" "159%" "161%" "162%" "164%" "165%" "167%" "169%" "170%" "172%" "173%" "175%" "176%" "178%" "180%" "181%" "183%" "184%" "186%" "187%" "189%" "191%" "192%" "194%" "195%" "197%" "198%" "200%"
list arpspeed "200%" "1" "2" "100%" "4" "5" "6" "7" "8" "25%"
group "Sound"
param sound 0 "Sound" 1932 2031 list=sounds init=1932 sound=1
group "Track"
param cc 7 "Volume" 0 127 init=100
param cc 10 "Pan" 0 127 init=64 show=-64
param cc 91 "Reverb send" 0 127
param cc 94 "Delay send" 0 127
param cc 20 "EQ high" 40 88 init=64 list=eq
param cc 21 "EQ low" 40 88 init=64 list=eq
group "Filter/EG"
param cc 74 "Cutoff" 0 127 init=64 show=-64
param cc 71 "Resonance" 0 127 init=64 show=-64
param cc 73 "Attack" 0 127 init=64 show=-64
param cc 75 "Decay/release" 0 127 init=64 show=-64
group "Play"
param cc 26 "Mono/Poly/Chord" 0 2 init=1 list=mono
param cc 65 "Portamento" 0 1 list=onoff
param cc 5 "Portamento time" 0 127
param cc 27 "Arp" 0 15 list=arps
param cc 28 "Arp gate" 0 127 init=64 list=arpgate
param cc 29 "Arp speed" 0 9 init=3 list=arpspeed
group "FM"
param cc 116 "Algorithm" 0 11 show=1
param cc 117 "Mod amount" 0 127
param cc 118 "Mod frequency" 0 127
param cc 119 "Feedback" 0 127
group "Effects"
param cc 107 "Single FX 1" 0 127
param cc 108 "Single FX 2" 0 127
param cc 109 "Single FX 3" 0 127
param cc 102 "Master FX1 1" 0 127
param cc 103 "Master FX1 2" 0 127
param cc 104 "Master FX1 3" 0 127
param cc 105 "Master FX2" 0 127
param cc 106 "Master FX3" 0 127
param cc 110 "Reverb 1" 0 127
param cc 111 "Reverb 2" 0 127
param cc 112 "Reverb 3" 0 127
param cc 113 "Delay 1" 0 127
param cc 114 "Delay 2" 0 127
param cc 115 "Delay 3" 0 127
