# Torso T-1 for the EUCLID edition of the Polyend Tracker.
# The T-1 takes no CCs for its own settings; program changes pick its bank
# and pattern (docs.torsoelectronics.com/t1/appendix/midi-program-change-map):
# on MIDI channel 1 programs 0-127 are banks 1-8, on channel 2 banks 9-16
# (16 patterns a bank). Turn on "Enable MIDI Program In" in T1 Config >
# MIDI I/O. These go out on channels 1 and 2 whatever the Device is.
synth "Torso T-1"
hint "Banks rows pick the T-1's pattern"
pause 1
device 1
port din
template pc1 C0 v
template pc2 C1 v
list bank1to8 "B1 P1" "B1 P2" "B1 P3" "B1 P4" "B1 P5" "B1 P6" "B1 P7" "B1 P8" "B1 P9" "B1 P10" "B1 P11" "B1 P12" "B1 P13" "B1 P14" "B1 P15" "B1 P16" "B2 P1" "B2 P2" "B2 P3" "B2 P4" "B2 P5" "B2 P6" "B2 P7" "B2 P8" "B2 P9" "B2 P10" "B2 P11" "B2 P12" "B2 P13" "B2 P14" "B2 P15" "B2 P16" "B3 P1" "B3 P2" "B3 P3" "B3 P4" "B3 P5" "B3 P6" "B3 P7" "B3 P8" "B3 P9" "B3 P10" "B3 P11" "B3 P12" "B3 P13" "B3 P14" "B3 P15" "B3 P16" "B4 P1" "B4 P2" "B4 P3" "B4 P4" "B4 P5" "B4 P6" "B4 P7" "B4 P8" "B4 P9" "B4 P10" "B4 P11" "B4 P12" "B4 P13" "B4 P14" "B4 P15" "B4 P16" "B5 P1" "B5 P2" "B5 P3" "B5 P4" "B5 P5" "B5 P6" "B5 P7" "B5 P8" "B5 P9" "B5 P10" "B5 P11" "B5 P12" "B5 P13" "B5 P14" "B5 P15" "B5 P16" "B6 P1" "B6 P2" "B6 P3" "B6 P4" "B6 P5" "B6 P6" "B6 P7" "B6 P8" "B6 P9" "B6 P10" "B6 P11" "B6 P12" "B6 P13" "B6 P14" "B6 P15" "B6 P16" "B7 P1" "B7 P2" "B7 P3" "B7 P4" "B7 P5" "B7 P6" "B7 P7" "B7 P8" "B7 P9" "B7 P10" "B7 P11" "B7 P12" "B7 P13" "B7 P14" "B7 P15" "B7 P16" "B8 P1" "B8 P2" "B8 P3" "B8 P4" "B8 P5" "B8 P6" "B8 P7" "B8 P8" "B8 P9" "B8 P10" "B8 P11" "B8 P12" "B8 P13" "B8 P14" "B8 P15" "B8 P16"
list bank9to16 "B9 P1" "B9 P2" "B9 P3" "B9 P4" "B9 P5" "B9 P6" "B9 P7" "B9 P8" "B9 P9" "B9 P10" "B9 P11" "B9 P12" "B9 P13" "B9 P14" "B9 P15" "B9 P16" "B10 P1" "B10 P2" "B10 P3" "B10 P4" "B10 P5" "B10 P6" "B10 P7" "B10 P8" "B10 P9" "B10 P10" "B10 P11" "B10 P12" "B10 P13" "B10 P14" "B10 P15" "B10 P16" "B11 P1" "B11 P2" "B11 P3" "B11 P4" "B11 P5" "B11 P6" "B11 P7" "B11 P8" "B11 P9" "B11 P10" "B11 P11" "B11 P12" "B11 P13" "B11 P14" "B11 P15" "B11 P16" "B12 P1" "B12 P2" "B12 P3" "B12 P4" "B12 P5" "B12 P6" "B12 P7" "B12 P8" "B12 P9" "B12 P10" "B12 P11" "B12 P12" "B12 P13" "B12 P14" "B12 P15" "B12 P16" "B13 P1" "B13 P2" "B13 P3" "B13 P4" "B13 P5" "B13 P6" "B13 P7" "B13 P8" "B13 P9" "B13 P10" "B13 P11" "B13 P12" "B13 P13" "B13 P14" "B13 P15" "B13 P16" "B14 P1" "B14 P2" "B14 P3" "B14 P4" "B14 P5" "B14 P6" "B14 P7" "B14 P8" "B14 P9" "B14 P10" "B14 P11" "B14 P12" "B14 P13" "B14 P14" "B14 P15" "B14 P16" "B15 P1" "B15 P2" "B15 P3" "B15 P4" "B15 P5" "B15 P6" "B15 P7" "B15 P8" "B15 P9" "B15 P10" "B15 P11" "B15 P12" "B15 P13" "B15 P14" "B15 P15" "B15 P16" "B16 P1" "B16 P2" "B16 P3" "B16 P4" "B16 P5" "B16 P6" "B16 P7" "B16 P8" "B16 P9" "B16 P10" "B16 P11" "B16 P12" "B16 P13" "B16 P14" "B16 P15" "B16 P16"
