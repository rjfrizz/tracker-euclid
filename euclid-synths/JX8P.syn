# Roland JX-8P tone editor for the EUCLID edition of the Polyend Tracker.
# Generated by euclid-synths/tools/jx8p_from_editor.py from Jx8pSysex.cpp in
# grapelanestudios/Jx8pEditor (MIT License, Copyright (c) 2026 Grapelane Studio).
# Edits the tone with IPR messages. The JX-8P sends a tone (APR) when one is
# chosen on it, and this listens for that: there's no asking for it.
# Device is the JX-8P's MIDI channel.
synth "Roland JX-8P"
hint "Pick a tone on the JX-8P: it fills this page"
pause 20
device 1
port din
listen
template ipr F0 41 36 d+00 21 20 01 p v F7
dump ipr F0 41 35 d+00 21 20 01 data F7
name ipr 0 10
group "DCO-1"
param ipr 11 "DCO-1 Range" 0 127
param ipr 12 "DCO-1 Waveform" 0 127
param ipr 13 "DCO-1 Tune" 0 127
param ipr 14 "DCO-1 LFO Depth" 0 127
param ipr 15 "DCO-1 Env Depth" 0 127
group "DCO-2"
param ipr 16 "DCO-2 Range" 0 127
param ipr 17 "DCO-2 Waveform" 0 127
param ipr 18 "DCO-2 Cross Mod" 0 127
param ipr 19 "DCO-2 Tune" 0 127
param ipr 20 "DCO-2 Fine Tune" 0 127
param ipr 21 "DCO-2 LFO Depth" 0 127
param ipr 22 "DCO-2 Env Depth" 0 127
group "DCO/Mixer"
param ipr 26 "DCO Dynamics" 0 127
param ipr 27 "DCO Env Mode" 0 127
param ipr 28 "Mixer DCO-1" 0 127 init=100
param ipr 29 "Mixer DCO-2" 0 127
param ipr 30 "Mixer Env Depth" 0 127
param ipr 31 "Mixer Dynamics" 0 127
param ipr 32 "Mixer Env Mode" 0 127
group "Filter"
param ipr 33 "HPF Cutoff" 0 127
param ipr 34 "VCF Cutoff" 0 127 init=127
param ipr 35 "VCF Resonance" 0 127
param ipr 36 "VCF LFO Depth" 0 127
param ipr 37 "VCF Env Depth" 0 127
param ipr 38 "VCF Key Follow" 0 127
param ipr 39 "VCF Dynamics" 0 127
param ipr 40 "VCF Env Mode" 0 127
group "VCA/LFO"
param ipr 41 "VCA Level" 0 127 init=100
param ipr 42 "VCA Dynamics" 0 127
param ipr 43 "Chorus" 0 127
param ipr 44 "LFO Waveform" 0 127
param ipr 45 "LFO Delay" 0 127
param ipr 46 "LFO Rate" 0 127
param ipr 58 "VCA Env Mode" 0 127
group "Envelopes"
param ipr 47 "ENV-1 Attack" 0 127
param ipr 48 "ENV-1 Decay" 0 127
param ipr 49 "ENV-1 Sustain" 0 127 init=100
param ipr 50 "ENV-1 Release" 0 127
param ipr 51 "ENV-1 Key Follow" 0 127
param ipr 52 "ENV-2 Attack" 0 127
param ipr 53 "ENV-2 Decay" 0 127
param ipr 54 "ENV-2 Sustain" 0 127 init=100
param ipr 55 "ENV-2 Release" 0 127
param ipr 56 "ENV-2 Key Follow" 0 127
